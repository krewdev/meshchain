# /etc/meshchain/relayer.env  (copy from this example; chmod 600)
#
# Solana devnet RPC + hot wallet for AnchorProvider.env()
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
ANCHOR_WALLET=/home/meshchain/.config/solana/id.json

# Mesh host
MESHCHAIN_ROOT=/opt/meshchain
MESHCHAIN_DATA=/opt/meshchain/data/host
MESH_MINT_PEER=127.0.0.1:9100
MESH_MINT_VALIDATOR_INDEX=0
# MESH_BRIDGE_IDL=/opt/meshchain/programs-mesh-bridge/idl/programs_mesh_bridge.json
# MESHCHAIN_BIN=/opt/meshchain/target/release/meshchain-node
