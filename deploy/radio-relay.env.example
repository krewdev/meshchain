# /etc/meshchain/radio-relay.env
# Hardware:
#   MESH_RADIO_FLAGS=--port /dev/ttyUSB0 --channel-index 0
# Mock (no radio — air path loopback for lab):
#   MESH_RADIO_FLAGS=--mock

MESH_RADIO_FLAGS=--mock
MESH_RADIO_LISTEN=127.0.0.1:9199
MESH_RADIO_TCP=127.0.0.1:9100
MESH_RADIO_TIP_SECS=30
# chain_state + genesis for air balance + AirBlockAck index→pubkey
MESHCHAIN_DATA=/opt/meshchain/data/host
